{
  "name": "myio-widget-build",
  "private": true,
  "scripts": {
    "build": "esbuild inst/htmlwidgets/myIO/src/index.js --bundle --format=iife --external:@duckdb/duckdb-wasm --loader:.wasm=file --outfile=inst/htmlwidgets/myIO/myIOapi.js",
    "build:worker": "esbuild inst/htmlwidgets/myIO/src/renderers/webgl/beeswarm-layout.worker.js --bundle --format=iife --outfile=inst/htmlwidgets/myIO/workers/beeswarm-layout.js",
    "watch": "esbuild inst/htmlwidgets/myIO/src/index.js --bundle --format=iife --outfile=inst/htmlwidgets/myIO/myIOapi.js --watch",
    "verify": "npm run build && node -e \"require('fs').readFileSync('inst/htmlwidgets/myIO/myIOapi.js','utf8')\" && echo 'Bundle OK'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:playwright": "playwright test tests/playwright"
  },
  "dependencies": {
    "alasql": "^4.4.0",
    "apache-arrow": "^17.0.0",
    "d3-force": "^3.0.0",
    "regl": "^2.1.0",
    "regl-scatterplot": "^1.12.0",
    "tsdownsample": "^0.1.3"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "^1.28.0",
    "@playwright/test": "^1.47.0",
    "@vitest/coverage-v8": "^3.2.4",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
